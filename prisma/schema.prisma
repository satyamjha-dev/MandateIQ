// Prisma 7 Schema configuration for MandateIQ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id               String        @id @default(uuid())
  filename         String
  source           String        @default("CSV") // "BANK_STATEMENT" | "GPAY" | "PHONEPE" | "CSV"
  status           String        @default("SUCCESS") // "SUCCESS" | "FAILED" | "PENDING"
  transactionCount Int           @default(0) @map("transaction_count")
  createdAt        DateTime      @default(now()) @map("created_at")
  transactions     Transaction[]

  @@map("import_batches")
}

model Transaction {
  id                    String       @id @default(uuid())
  importBatchId         String       @map("import_batch_id")
  transactionDate       DateTime     @map("transaction_date")
  rawDescription        String       @map("raw_description")
  normalizedDescription String       @map("normalized_description")
  amount                Decimal      @db.Decimal(12, 2)
  currency              String       @default("INR")
  transactionType       String       @map("transaction_type") // "DEBIT" | "CREDIT"
  referenceId           String?      @map("reference_id")
  merchantId            String?      @map("merchant_id")
  createdAt             DateTime     @default(now()) @map("created_at")

  importBatch           ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  merchant              Merchant?    @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([merchantId])
  @@index([transactionDate])
  @@map("transactions")
}

model Merchant {
  id            String          @id @default(uuid())
  canonicalName String          @unique @map("canonical_name")
  category      String?
  createdAt     DateTime        @default(now()) @map("created_at")
  aliases       MerchantAlias[]
  transactions  Transaction[]

  @@map("merchants")
}

model MerchantAlias {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  alias      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([alias])
  @@map("merchant_aliases")
}