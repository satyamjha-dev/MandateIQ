# ==============================================================================
# MandateIQ - Environment Variables Template
# Copy this file to .env and fill in the values for local development:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL credentials for Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mandateiq_db

# PostgreSQL connection string for Prisma 7 and application runtime
# Format: postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/mandateiq_db?schema=public"

# Optional direct connection URL (if using external connection poolers like PgBouncer)
DIRECT_URL="postgresql://postgres:your_secure_password_here@localhost:5432/mandateiq_db?schema=public"

# Node Environment
NODE_ENV=development

